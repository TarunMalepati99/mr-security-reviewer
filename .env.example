# Copy to .env in the project folder to go live; the CLI reads it automatically.
# With none of these set, the CLI runs entirely on the bundled fixture + stub analyzer.

# --- GitLab (real MR fetching + posting the review as a comment) ---
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com

# --- Gemini (real analysis instead of the pattern-matching stub) ---
GEMINI_API_KEY=
# Optional: which Gemini model to use (default gemini-3.6-flash)
GEMINI_MODEL=
